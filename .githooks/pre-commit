#!/bin/bash
# AegisGate MCP — pre-commit OPSEC hook
# Install: git config core.hooksPath .githooks
set -euo pipefail

# OPSEC scan (if script exists)
if [ -f tools/opsec-scan.sh ]; then
  bash tools/opsec-scan.sh --staged
fi

# gofmt check
UNFORMATTED=$(gofmt -l .)
if [ -n "$UNFORMATTED" ]; then
  echo "ERROR: Unformatted Go files:"
  echo "$UNFORMATTED"
  echo "Run: gofmt -w ."
  exit 1
fi

# go vet
if ! go vet ./... 2>&1; then
  echo "ERROR: go vet found issues"
  exit 1
fi

echo "Pre-commit checks passed ✅"